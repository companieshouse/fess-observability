{
	"variables": [
		{
			"type": "pattern",
			"pattern": "VAR_SERVICE",
			"inputType": "select",
			"id": "ServiceName",
			"label": "service",
			"visible": true,
			"inputPopulationType": "search",
			"search": "{AWS/ECS, ClusterName, ServiceName} MetricName=\"CPUUtilization\"",
			"populateFrom": "ServiceName"
		},
		{
			"type": "pattern",
			"pattern": "VAR_TARGET_GROUP",
			"inputType": "select",
			"id": "TargetGroup",
			"label": "target group",
			"visible": true,
			"inputPopulationType": "search",
			"search": "{AWS/ApplicationELB, LoadBalancer, TargetGroup} MetricName=\"RequestCount\"",
			"populateFrom": "TargetGroup"
		}
	],
	"widgets": [
		{
			"type": "text",
			"x": 0,
			"y": 0,
			"width": 24,
			"height": 2,
			"properties": {
				"markdown": "# VAR_SERVICE - Service Reliability Dashboard",
				"background": "transparent"
			}
		},
		{
			"type": "text",
			"x": 0,
			"y": 6,
			"width": 24,
			"height": 1,
			"properties": {
				"markdown": "## Saturation",
				"background": "transparent"
			}
		},
		{
			"type": "metric",
			"x": 0,
			"y": 2,
			"width": 6,
			"height": 4,
			"properties": {
				"metrics": [
					[{"expression": "SELECT AVG(CPUUtilization) FROM SCHEMA(\"AWS/ECS\", ClusterName, ServiceName) WHERE ServiceName = 'VAR_SERVICE'", "label": "CPU (%)", "id": "q1", "region": "eu-west-2"}]
				],
				"sparkline": true,
				"view": "singleValue",
				"region": "eu-west-2",
				"stat": "Average",
				"period": 300,
				"title": "CPU Utilisation (%)",
				"singleValueFullPrecision": false,
				"liveData": false,
				"legend": {"position": "hidden"}
			}
		},
		{
			"type": "metric",
			"x": 6,
			"y": 2,
			"width": 6,
			"height": 4,
			"properties": {
				"metrics": [
					[{"expression": "SELECT AVG(MemoryUtilization) FROM SCHEMA(\"AWS/ECS\", ClusterName, ServiceName) WHERE ServiceName = 'VAR_SERVICE'", "label": "Memory (%)", "id": "q1", "region": "eu-west-2"}]
				],
				"sparkline": true,
				"view": "singleValue",
				"region": "eu-west-2",
				"stat": "Average",
				"period": 300,
				"title": "Memory Utilisation (%)",
				"singleValueFullPrecision": false,
				"liveData": false,
				"legend": {"position": "hidden"}
			}
		},
		{
			"type": "metric",
			"x": 12,
			"y": 2,
			"width": 6,
			"height": 4,
			"properties": {
				"metrics": [
					[{"expression": "SELECT MAX(RunningTaskCount) FROM SCHEMA(\"ECS/ContainerInsights\", ClusterName, ServiceName) WHERE ServiceName = 'VAR_SERVICE'", "label": "Running", "id": "q1", "region": "eu-west-2"}]
				],
				"sparkline": true,
				"view": "singleValue",
				"region": "eu-west-2",
				"stat": "Maximum",
				"period": 300,
				"singleValueFullPrecision": false,
				"setPeriodToTimeRange": false,
				"liveData": false,
				"title": "Running Tasks",
				"legend": {"position": "hidden"}
			}
		},
		{
			"type": "metric",
			"x": 18,
			"y": 2,
			"width": 6,
			"height": 4,
			"properties": {
				"metrics": [
					[{"expression": "SELECT MAX(DesiredTaskCount) FROM SCHEMA(\"ECS/ContainerInsights\", ClusterName, ServiceName) WHERE ServiceName = 'VAR_SERVICE'", "label": "Desired", "id": "q1", "region": "eu-west-2"}]
				],
				"sparkline": true,
				"view": "singleValue",
				"region": "eu-west-2",
				"stat": "Maximum",
				"period": 300,
				"title": "Desired Tasks",
				"legend": {"position": "hidden"}
			}
		},
		{
			"type": "metric",
			"x": 0,
			"y": 7,
			"width": 12,
			"height": 6,
			"properties": {
				"metrics": [
					[{"expression": "SELECT AVG(CPUUtilization) FROM SCHEMA(\"AWS/ECS\", ClusterName, ServiceName) WHERE ServiceName = 'VAR_SERVICE'", "label": "CPU (%)", "id": "q1", "region": "eu-west-2"}]
				],
				"view": "timeSeries",
				"stacked": false,
				"region": "eu-west-2",
				"stat": "Average",
				"period": 300,
				"title": "CPU Utilisation (%)"
			}
		},
		{
			"type": "metric",
			"x": 12,
			"y": 7,
			"width": 12,
			"height": 6,
			"properties": {
				"metrics": [
					[{"expression": "SELECT AVG(MemoryUtilization) FROM SCHEMA(\"AWS/ECS\", ClusterName, ServiceName) WHERE ServiceName = 'VAR_SERVICE'", "label": "Memory (%)", "id": "q1", "region": "eu-west-2"}]
				],
				"view": "timeSeries",
				"stacked": false,
				"region": "eu-west-2",
				"stat": "Average",
				"period": 300,
				"title": "Memory Utilisation (%)"
			}
		},
		{
			"type": "text",
			"x": 0,
			"y": 13,
			"width": 24,
			"height": 1,
			"properties": {
				"markdown": "## Deployments",
				"background": "transparent"
			}
		},
		{
			"type": "metric",
			"x": 0,
			"y": 14,
			"width": 12,
			"height": 6,
			"properties": {
				"metrics": [
					[{"expression": "SEARCH('{ECS/ContainerInsights,ClusterName,ServiceName} MetricName=\"RunningTaskCount\" ServiceName=\"VAR_SERVICE\"', 'Maximum', 60)", "label": "Running", "id": "q1", "region": "eu-west-2"}],
					[{"expression": "SEARCH('{ECS/ContainerInsights,ClusterName,ServiceName} MetricName=\"DesiredTaskCount\" ServiceName=\"VAR_SERVICE\"', 'Maximum', 60)", "label": "Desired", "id": "q2", "region": "eu-west-2"}],
					[{"expression": "SEARCH('{ECS/ContainerInsights,ClusterName,ServiceName} MetricName=\"PendingTaskCount\" ServiceName=\"VAR_SERVICE\"', 'Maximum', 60)", "label": "Pending", "id": "q3", "region": "eu-west-2"}]
				],
				"view": "timeSeries",
				"stacked": false,
				"region": "eu-west-2",
				"stat": "Maximum",
				"period": 60,
				"title": "Task Counts"
			}
		},
		{
			"type": "metric",
			"x": 12,
			"y": 14,
			"width": 12,
			"height": 6,
			"properties": {
				"metrics": [
					[{"expression": "SELECT MAX(DeploymentCount) FROM SCHEMA(\"ECS/ContainerInsights\", ClusterName, ServiceName) WHERE ServiceName = 'VAR_SERVICE'", "label": "Deployments", "id": "q1", "region": "eu-west-2"}]
				],
				"view": "timeSeries",
				"stacked": false,
				"region": "eu-west-2",
				"stat": "Maximum",
				"period": 60,
				"title": "Active Deployments"
			}
		},
		{
			"type": "text",
			"x": 0,
			"y": 20,
			"width": 24,
			"height": 1,
			"properties": {
				"markdown": "## Traffic, Latency and Errors (target group: VAR_TARGET_GROUP)",
				"background": "transparent"
			}
		},
		{
			"type": "metric",
			"x": 0,
			"y": 21,
			"width": 8,
			"height": 6,
			"properties": {
				"metrics": [
					[{"expression": "SUM(SEARCH('{AWS/ApplicationELB,LoadBalancer,TargetGroup} MetricName=\"RequestCount\" TargetGroup=\"VAR_TARGET_GROUP\"', 'Sum', 300))", "label": "Requests", "id": "requests", "region": "eu-west-2"}]
				],
				"view": "timeSeries",
				"stacked": false,
				"region": "eu-west-2",
				"stat": "Sum",
				"period": 300,
				"title": "Traffic - Request Count"
			}
		},
		{
			"type": "metric",
			"x": 8,
			"y": 21,
			"width": 8,
			"height": 6,
			"properties": {
				"metrics": [
					[{"expression": "SUM(SEARCH('{AWS/ApplicationELB,LoadBalancer,TargetGroup} MetricName=\"RequestCount\" TargetGroup=\"VAR_TARGET_GROUP\"', 'Sum', 300))", "label": "Requests", "id": "requests", "region": "eu-west-2"}]
				],
				"view": "timeSeries",
				"stacked": false,
				"region": "eu-west-2",
				"stat": "Sum",
				"period": 300,
				"title": "Traffic - Request Count"
			}
		},
		{
			"type": "metric",
			"x": 16,
			"y": 21,
			"width": 8,
			"height": 6,
			"properties": {
				"metrics": [
					[{"expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer,TargetGroup} MetricName=\"TargetResponseTime\" TargetGroup=\"VAR_TARGET_GROUP\"', 'p95', 300)", "label": "p95", "id": "latency", "region": "eu-west-2"}]
				],
				"view": "timeSeries",
				"stacked": false,
				"region": "eu-west-2",
				"stat": "p95",
				"period": 300,
				"title": "Latency - p95 Response Time (s)"
			}
		},
		{
			"type": "metric",
			"x": 0,
			"y": 21,
			"width": 8,
			"height": 6,
			"properties": {
				"metrics": [
					[{"expression": "(errors / requests) * 100", "label": "5XX rate (%)", "id": "rate", "region": "eu-west-2"}],
					[{"expression": "SUM(SEARCH('{AWS/ApplicationELB,LoadBalancer,TargetGroup} MetricName=\"RequestCount\" TargetGroup=\"VAR_TARGET_GROUP\"', 'Sum', 300))", "id": "requests", "visible": false, "region": "eu-west-2"}],
					[{"expression": "SUM(SEARCH('{AWS/ApplicationELB,LoadBalancer,TargetGroup} MetricName=\"HTTPCode_Target_5XX_Count\" TargetGroup=\"VAR_TARGET_GROUP\"', 'Sum', 300))", "id": "errors", "visible": false, "region": "eu-west-2"}]
				],
				"view": "timeSeries",
				"stacked": false,
				"region": "eu-west-2",
				"stat": "Sum",
				"period": 300,
				"title": "Errors - 5XX Rate (%)"
			}
		}
	]
}